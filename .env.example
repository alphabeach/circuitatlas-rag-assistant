# ---------------------------------------------------------------------------
# Provider selection
# ---------------------------------------------------------------------------
# "gemini" (default) or "openrouter".
#
# Gemini is the default because the AI Studio free tier needs no credit
# card. OpenRouter's free-model pool is capped at 50 requests per day on a
# zero-credit account, which cannot support ingesting a document plus
# serving queries.
AI_PROVIDER=gemini

# ---------------------------------------------------------------------------
# Google AI Studio (Gemini) - free tier, no credit card required.
# Key from https://aistudio.google.com/apikey
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_CHAT_FALLBACK_MODEL=gemini-3.6-flash

# ---------------------------------------------------------------------------
# OpenRouter - alternative provider. Needs a funded account.
#
# Note: OpenRouter's free models work without credits but are limited to
# 50 requests per day. Adding $10 of credit raises that to 1000 free
# requests per day, which is enough to run the free models in practice.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_CHAT_MODEL=anthropic/claude-3.5-sonnet

# Optional: fall back to OpenAI for embeddings if the primary provider fails.
# Requires OPENAI_API_KEY to be set as well.
EMBEDDING_FALLBACK_OPENAI=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Vector dimension. MUST match the pgvector column.
#   768  - Gemini gemini-embedding-001 (Matryoshka-trained; recommended)
#   1536 - OpenAI text-embedding-3-small
#
# Changing this requires a schema migration and a full re-embed, because
# embedding spaces from different models are not comparable.
# ---------------------------------------------------------------------------
EMBEDDING_DIMENSIONS=768

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket that holds the original uploaded SOP files.
SUPABASE_STORAGE_BUCKET=protocol-files
