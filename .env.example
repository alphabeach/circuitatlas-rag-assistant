# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Bypasses RLS. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# OpenRouter
# ---------------------------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key

# Chat model. claude-3.5-sonnet was retired by Anthropic; the Sonnet 4.5
# generation is the current stable replacement. Override per environment.
OPENROUTER_CHAT_MODEL=anthropic/claude-sonnet-4.5

# Embedding model. Must match the vector dimension in the pgvector column
# (see supabase/migrations/*). openai/text-embedding-3-small -> 1536 dims.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Storage bucket that holds the original uploaded SOP files.
SUPABASE_STORAGE_BUCKET=protocol-files

# Set to 1 to also try OpenAI directly for embeddings when OpenRouter fails.
# Requires OPENAI_API_KEY to be set.
EMBEDDING_FALLBACK_OPENAI=
OPENAI_API_KEY=
